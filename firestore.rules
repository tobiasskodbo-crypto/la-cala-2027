rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alle med lenken kan lese og føre score. Kun appens tre samlinger er åpne.
    match /trip/{doc}   { allow read, write: if true; }
    match /rounds/{doc} { allow read, write: if true; }
    match /scores/{doc} { allow read, write: if request.resource == null || request.resource.size() < 50; }
    match /{document=**} { allow read, write: if false; }
  }
}
